# Copia este archivo a .env y llena los valores. Nunca subas el .env al repo.

# URL de la API (Servia_BE)
VITE_API_URL=http://localhost:3000

# Configuración de la app web registrada en Firebase (Consola → Configuración del proyecto → Tus apps).
# No es secreta, pero cada quien la toma de docs/firebase.md (Servia_BE#20).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave VAPID para las notificaciones push web (MVP-29)
VITE_FIREBASE_VAPID_KEY=
